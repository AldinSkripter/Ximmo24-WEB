{
    "name": "ebroker",
    "version": "1.6.0",
    "private": true,
    "scripts": {
        "dev": "next dev --turbopack",
        "build": "node scripts/setup-sitemap.js && next build",
        "vercel:build": "node scripts/setup-sitemap.js && next build && cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/",
        "lint": "eslint . --ext .js,.jsx,.mjs,.cjs,.ts,.tsx",
        "export": "node scripts/setup-sitemap.js && next build",
        "start": "NODE_ENV=production NODE_PORT=8001 node server.js",
        "start:vps": "NODE_ENV=production PORT=8001 HOSTNAME=0.0.0.0 node .next/standalone/server.js",
        "start:pm2": "pm2 start ecosystem.config.cjs",
        "restart:pm2": "pm2 restart ecosystem.config.cjs",
        "stop:pm2": "pm2 stop ecosystem.config.cjs",
        "generate:standalone-htaccess": "node scripts/generate-standalone-htaccess.js",
        "deploy:vps": "bash deploy-vps.sh"
    },
